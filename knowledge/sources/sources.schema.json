{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baoliguard.org/schemas/sources.schema.json",
  "title": "IKSSourceTraceability",
  "description": "Schema enforcing academic and research traceability for all IKS and conservation assertions.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "source_id",
      "title",
      "publisher",
      "year",
      "url",
      "topic"
    ],
    "properties": {
      "source_id": {
        "type": "string",
        "description": "Unique identifier e.g. SRC_ASI_CONSERVATION_MANUAL_2020"
      },
      "title": {
        "type": "string"
      },
      "publisher": {
        "type": "string"
      },
      "year": {
        "type": ["integer", "string"]
      },
      "url": {
        "type": "string"
      },
      "topic": {
        "type": "string"
      },
      "claim_supported": {
        "type": "string",
        "description": "Specific conservation principle or material rule substantiated by this source"
      },
      "claims_supported": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "List of specific conservation, engineering, or hydrological claims substantiated by this source"
      }
    }
  }
}
